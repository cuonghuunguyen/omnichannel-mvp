# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (workspace-wide)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (any package)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated clients (any package)
**/src/generated/prisma

# Local SQLite databases
*.db
*.db-journal
prisma/*.db
.playwright-cli