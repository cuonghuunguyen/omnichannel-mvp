# Chat service env. Copy to `.env` and fill in.
#   cp .env.example .env
#
# NOTE: Prisma does NOT auto-load this file — prisma.config.ts does
# `import "dotenv/config"`. See https://pris.ly/prisma-config-env-vars.

# Chat DB (MySQL; User/Conversation/Message, separate from the API's agent DB).
# The `chat` database is created by docker/mysql-init.sql.
DATABASE_URL="mysql://app:app@localhost:3307/chat"

# AI Config API service (agents + knowledge/RAG). The chat service calls it via
# the generated client. API_URL is used server-side (orchestration); the public
# one is used by the browser admin UI (CORS-enabled on the API).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Multi-tenancy + AI service callbacks ─────────────────────────────────────
# This deployment serves EVERY tenant; there is no TENANT_ID. Visitors sign in /
# sign up a tenant by name at the door (POST /api/tenants), which sets an httpOnly
# cookie every server route reads and (on sign-up) registers the tenant with the
# AI Config API. Conversations/users/agents/knowledge are all scoped to it.
# Shared secret used both ways: the AI Config API calls this service's internal
# callback endpoint, and this service calls the API's /internal/tenants sync.
# Must match the API's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=dev-internal-secret

# NOTE: The AI engine (model keys, guardrails, RAG/embeddings) lives in the
# AI Config API service — see packages/api/.env. The chat service only persists
# conversations and proxies turns to the API.
