# Chat service env. Copy to `.env` and fill in.
#   cp .env.example .env
#
# NOTE: Prisma does NOT auto-load this file — prisma.config.ts does
# `import "dotenv/config"`. See https://pris.ly/prisma-config-env-vars.

# Chat SQLite DB (User/Conversation/Message; separate from the API's agent DB).
DATABASE_URL="file:./dev.db"

# AI Config API service (agents + knowledge/RAG). The chat service calls it via
# the generated client. API_URL is used server-side (orchestration); the public
# one is used by the browser admin UI (CORS-enabled on the API).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Multi-tenancy + AI service callbacks ─────────────────────────────────────
# The tenant this chat deployment serves. Conversations/users are scoped to it,
# and it is sent to the AI Config API so agents/knowledge resolve in-tenant.
TENANT_ID=default
# Shared secret the AI Config API uses to call this service's internal callback
# endpoint (/api/internal/...). Must match the API's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=dev-internal-secret

# NOTE: The AI engine (model keys, guardrails, RAG/embeddings) lives in the
# AI Config API service — see packages/api/.env. The chat service only persists
# conversations and proxies turns to the API.
