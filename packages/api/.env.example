# AI Config API service env. Copy to `.env` and fill in.
#   cp .env.example .env

# Agent + knowledge-registry DB (MySQL; owned by this service, separate from the
# chat DB). The `agents` database is created by docker/mysql-init.sql.
DATABASE_URL="mysql://app:app@localhost:3307/agents"

# HTTP port for the Express service.
API_PORT=4000
# Comma-separated allowed CORS origins (the chat app). Defaults to reflect any.
# CORS_ORIGIN=http://localhost:3000

# ── Multi-tenancy + conversation-event webhook ───────────────────────────────
# This deployment serves EVERY tenant; there is no TENANT_ID. Each request
# carries its tenant: admin/RAG routes via the X-Tenant-Id header, /chat via the
# request body, the OpenAI facade via the Bearer key. Tenants are created at
# runtime by the chat app's sign-up (pushed here via POST /internal/tenants).
# Legacy in-repo chat integration: when a tenant has no webhookUrl configured,
# conversation events fall back to CHAT_URL/api/internal/... with this shared
# secret (X-Internal-Secret). Per-tenant webhooks (Tenant.webhookUrl +
# webhookSecret, HMAC X-Signature) are preferred for any third-party chat app.
INTERNAL_API_SECRET=dev-internal-secret
# Base URL of the chat service. Unset = events are dropped unless the tenant
# registers its own webhook.
CHAT_URL=http://localhost:3000

# Dev inbound API key for the OpenAI-compatible facade (/v1/chat/completions).
# Seeded (hashed) onto the default tenant; clients send it as `Bearer <key>`.
DEV_API_KEY=sk-agent-routing-dev

# API keys for AI agents / RAG pipeline. Provider chosen by model-id prefix.
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""

# Dedicated input-guardrail classifier model (falls back to each agent's model).
GUARD_MODEL="deepseek-v4-flash"

# ── RAG vector store ─────────────────────────────────────────────────────────
# Qdrant (see ../../docker-compose.yml; REST host port 6333). Buckets/documents
# live in the MySQL DB above; only chunk vectors live in Qdrant.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=   # only needed if Qdrant is secured (cloud / API-key mode)

# Embeddings provider used when a bucket doesn't pin its own.
#   local  -> @huggingface/transformers, Xenova/bge-small-en-v1.5 (384d), no key
#   openai -> text-embedding-3-small (1536d), needs OPENAI_API_KEY
#   voyage -> voyage-3 (1024d), needs VOYAGE_API_KEY
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# Model used for query rewrite + LLM reranking (falls back to DEFAULT_MODEL_ID).
# RAG_PIPELINE_MODEL=deepseek-chat
