{
  "name": "@agent-routing/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/server.ts",
    "openapi": "tsx src/openapi/generate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "rag:setup": "tsx scripts/rag-setup.ts",
    "rag:seed": "tsx scripts/rag-seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/deepseek": "^2.0.38",
    "@ai-sdk/google": "^3.0.88",
    "@ai-sdk/mcp": "^1.0.51",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "ai": "^6.0.205",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "markitdown-node": "^1.5.2",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
