// AI-config service schema. Owns the Agent table plus the RAG knowledge
// registry (Bucket/Document); chunk vectors themselves live in Qdrant, not
// here. The chat service owns User/Conversation/Message in a separate database
// (no cross-service FKs).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// A tenant (customer/workspace). Registry is duplicated in the chat service's
/// DB; this service owns agent + knowledge isolation per tenant. One tenant per
/// deployment is active (resolved from TENANT_ID env), but the data layer is
/// fully tenant-scoped so multiple tenants can share a store.
model Tenant {
  id            String   @id // stable slug, e.g. "default"
  name          String
  // Per-tenant conversation-event webhook (assistant_message/set_agent/escalate/
  // close). When set, events POST here with an HMAC X-Signature; when null, they
  // fall back to the legacy CHAT_URL internal callback (the in-repo chat service).
  webhookUrl    String?  @db.Text
  webhookSecret String? // HMAC-SHA256 secret for the webhook X-Signature
  // sha256(hex) of the inbound API key for the OpenAI-compatible facade. Auth
  // resolves the calling tenant by hashing the Bearer token and matching here.
  apiKeyHash    String?  @unique
  // Per-workspace guardrail model override (D-06 Phase 41).
  // null = use the agent's own chat model as the guardrail classifier.
  guardModel    String?
  createdAt     DateTime @default(now())
  agents        Agent[]
  buckets       Bucket[]
}

/// AI agent definitions produced by the agent builder.
model Agent {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  name         String
  // NOTE: MySQL TEXT columns can't carry a literal DEFAULT, so these long/JSON
  // fields have no DB default — create-time defaults are supplied in the app
  // (see AGENT_CREATE_DEFAULTS in routes/agents.ts).
  description  String   @db.Text // surfaced in deliver_to_agent schema
  systemPrompt String   @db.Text // master prompt
  model        String   @default("deepseek-chat")
  temperature  Float    @default(0.7)
  isRoutable   Boolean  @default(true) // can be a deliver_to_agent target
  isDefault    Boolean  @default(false) // entry agent for new conversations
  builtinTools String   @db.Text // JSON { sendMessage, deliverToAgent, deliverToHuman, endConversation: bool }
  customTools  String   @db.Text // JSON [{ name, description, schema, endpoint }]
  mcpServers   String   @db.Text // JSON [{ name, url, headers? }]
  handoffRules String   @db.Text // JSON deliver_to_human rules
  guardrails   String   @db.Text // JSON { enabled, scope, refusal }
  knowledge    String   @db.Text // JSON { enabled, bucketIds, topK } — RAG buckets (Qdrant store)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A RAG knowledge bucket. Pins one embedding provider+model+dimension; its
/// chunk vectors live in a dedicated Qdrant collection (see lib/rag/store.ts).
/// This row is the relational registry (CRUD, listing, counts).
model Bucket {
  id                String     @id @default(uuid())
  tenantId          String     @default("default")
  name              String
  description       String     @db.Text // no DB default (MySQL TEXT); set in createBucket
  embeddingProvider String // "local" | "openai" | "voyage"
  embeddingModel    String
  embeddingDim      Int
  createdAt         DateTime   @default(now())
  // Running average chunk length (token count), maintained on each storeDocument()
  // upsert; feeds BM25 document-length normalization (D-10 Phase 45).
  avgChunkLength    Float      @default(0)
  // Optional per-bucket override of the workspace-wide relevance-floor default
  // (D-06 Phase 45). null = fall back to the tenant/env-configured default.
  relevanceFloorOverride Float?
  documents         Document[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A document ingested into a bucket. The text is chunked, embedded, and stored
/// as points in the bucket's Qdrant collection; this row tracks provenance and
/// the chunk count for listing. Deleting it also deletes its Qdrant points.
model Document {
  id         String   @id @default(uuid())
  tenantId   String   @default("default")
  bucketId   String
  title      String   @db.Text
  source     String   @db.Text // no DB default (MySQL TEXT); set in ingestDocument
  metadata   String   @db.Text // JSON blob; set in ingestDocument
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())
  // SHA-256 (hex) of the normalized raw text, computed pre-chunk/pre-embed.
  // Nullable so pre-migration rows never collide (MySQL treats multiple NULLs
  // in a unique index as distinct). Per-bucket exact-hash dedup (D-01/D-03/D-04
  // Phase 45).
  contentHash String? @db.VarChar(64)

  bucket   Bucket            @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([bucketId])
  @@index([tenantId])
  @@unique([bucketId, contentHash])
}

/// A snapshot of a document's full raw content at a point in time (Phase 46
/// D-08). The NEXT update diffs its new chunks against the latest version's
/// content to determine which chunks actually changed (D-09/D-10), rather than
/// always re-embedding the whole document. History is capped at
/// VERSION_HISTORY_CAP (document-versioning.ts) — oldest rows beyond the cap
/// are pruned by the update orchestration (Plan 46-03).
model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  content     String   @db.LongText // full raw content (can exceed 64KB TEXT limit)
  contentHash String   @db.VarChar(64) // this version's SHA-256 hex, same format as Document.contentHash
  chunkCount  Int      @default(0) // this version's resulting chunk count (D-07 delta indicator)
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}
