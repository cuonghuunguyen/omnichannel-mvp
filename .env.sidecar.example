# Agent-routing sidecar environment.
#
# Copy this file to `.env.sidecar` (gitignored) and fill in the real values.
# It is injected into the `api` container via `env_file:` in docker-compose.yml.
#
#   cp .env.sidecar.example .env.sidecar   # then edit

NODE_ENV=production
API_PORT=4000

# Prisma connection to the sidecar's OWN `agents` database (separate from the
# Laravel app DB, and a different DB user). On the staging host this points at
# host.docker.internal, which docker-compose.yml maps to the on-host socat shim
# via SIDECAR_HOST_GATEWAY (default 10.123.0.1). On a normal host, point it at
# your MySQL host directly.
DATABASE_URL=mysql://agents:CHANGE_ME@host.docker.internal:3306/agents

# Qdrant vector store, reached by compose service name on the shared network.
QDRANT_URL=http://qdrant:6333

# Embedding backend. `local` = in-process embeddings, no external API key needed.
EMBEDDING_PROVIDER=local

# Shared service-to-service secret for /internal/* routes (tenant sync, etc.).
# MUST equal Laravel's SIDECAR_INTERNAL_SECRET (config services.sidecar.internal_secret);
# if they drift, tenant sync and all agent CRUD fail with 401 -> "Failed to create agent".
INTERNAL_API_SECRET=CHANGE_ME
