// Agent chat system schema. See plan: multi-agent routing chat.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Guests and human operators.
model User {
  id            String         @id @default(cuid())
  name          String
  kind          String         @default("guest") // "guest" | "human_agent"
  info          String? // JSON blob of persisted per-user info
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  messages      Message[]      @relation("MessageAuthorUser")
}

/// AI agent definitions produced by the agent builder.
model Agent {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("") // surfaced in deliver_to_agent schema
  systemPrompt String   @default("") // master prompt
  model        String   @default("deepseek-chat")
  temperature  Float    @default(0.7)
  isRoutable   Boolean  @default(true) // can be a deliver_to_agent target
  isDefault    Boolean  @default(false) // entry agent for new conversations
  builtinTools String   @default("{}") // JSON { sendMessage, deliverToAgent, deliverToHuman: bool }
  customTools  String   @default("[]") // JSON [{ name, description, schema, endpoint }]
  mcpServers   String   @default("[]") // JSON [{ name, url, headers? }]
  handoffRules String   @default("[]") // JSON deliver_to_human rules
  guardrails   String   @default("{}") // JSON { enabled, scope, refusal }
  knowledge    String   @default("{}") // JSON { enabled, bucketIds, topK } — RAG buckets (in the Postgres store)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations Conversation[]
  messages      Message[]      @relation("MessageAuthorAgent")
}

/// One conversation == one session.
model Conversation {
  id             String   @id @default(cuid())
  userId         String
  title          String?
  routingFlag    String? // property used for initial routing
  assignmentType String   @default("ai") // "ai" | "human"
  currentAgentId String? // active AI agent
  humanAgentId   String? // claimed human operator (User.id)
  status         String   @default("open") // open | escalated | closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id])
  currentAgent Agent?    @relation(fields: [currentAgentId], references: [id])
  messages     Message[]

  @@index([userId])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | system | tool
  content        String   @default("") // plain text rendering
  parts          String? // JSON: full AI SDK UIMessage parts (tool calls, etc.)
  authorAgentId  String? // which AI agent authored
  authorUserId   String? // which human/guest authored
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorAgent  Agent?       @relation("MessageAuthorAgent", fields: [authorAgentId], references: [id])
  authorUser   User?        @relation("MessageAuthorUser", fields: [authorUserId], references: [id])

  @@index([conversationId])
}
